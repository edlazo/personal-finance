# Copiar a .env y ajustar. Las variables de entorno tienen prioridad sobre este archivo.
APP_NAME=Personal Finance API
# local | test | production
ENVIRONMENT=local
DEBUG=false
# En producción es obligatorio y de al menos 32 caracteres.
JWT_SECRET=solo-para-desarrollo-no-usar-en-produccion
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_finance
# Cotizaciones automáticas (worker): días hábiles cada 30 min en esas horas (cron), fines de semana 1 vez.
DOLARAPI_URL=https://dolarapi.com/v1/dolares
FX_TIMEZONE=America/Argentina/Buenos_Aires
FX_BUSINESS_HOURS=10-17
FX_DAILY_HOUR=12
# Precios de cripto (worker, cada hora). La key "demo" de CoinGecko es opcional.
COINGECKO_URL=https://api.coingecko.com/api/v3
COINGECKO_API_KEY=
# Clave Fernet de las credenciales de brokers; en producción es obligatoria. Se genera con:
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# CREDENTIALS_KEY=
