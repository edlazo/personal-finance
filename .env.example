# Copiar a .env y ajustar. Las variables de entorno tienen prioridad sobre este archivo.
APP_NAME=Personal Finance API
# local | test | production
ENVIRONMENT=local
DEBUG=false
# En producción es obligatorio y de al menos 32 caracteres.
JWT_SECRET=solo-para-desarrollo-no-usar-en-produccion
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/personal_finance
